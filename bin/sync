#!/usr/bin/env bash
#
# sync — wire ~/.agents into each agent's expected paths.
#
# Run this once per machine, and again whenever you add an agent.
# You do NOT need to run it after adding or editing a skill: the symlinks point
# at directories, so new files inside them are picked up immediately.
#
# DRY_RUN=1 ./bin/sync   shows what would happen without touching anything.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DRY_RUN="${DRY_RUN:-0}"
failed=0

say()  { printf '  %s\n' "$*"; }
warn() { printf '  !! %s\n' "$*" >&2; }

# link <target> <linkname>
link() {
  local target="$1" name="$2"

  if [ ! -e "$target" ]; then
    warn "skip $name — source $target does not exist"
    return 0
  fi

  # Refuse to clobber a real directory or file. Only ever replace our own symlinks.
  if [ -e "$name" ] && [ ! -L "$name" ]; then
    warn "skip $name — exists and is NOT a symlink. Move it aside, then re-run:"
    warn "     mv '$name' '$name.bak'"
    failed=1
    return 0
  fi

  if [ "$DRY_RUN" = "1" ]; then
    say "would link $name -> $target"
    return 0
  fi

  mkdir -p "$(dirname "$name")"
  ln -sfn "$target" "$name"
  say "linked $name -> $target"
}

# write <path> <content>
write() {
  local path="$1" content="$2"

  if [ -e "$path" ] && [ ! -L "$path" ] && ! grep -q '@.*AGENTS.md' "$path" 2>/dev/null; then
    warn "skip $path — has content that isn't ours. Merge it by hand:"
    warn "     add this line at the top:  @$ROOT/AGENTS.md"
    failed=1
    return 0
  fi

  if [ "$DRY_RUN" = "1" ]; then
    say "would write $path"
    return 0
  fi

  mkdir -p "$(dirname "$path")"
  printf '%s\n' "$content" > "$path"
  say "wrote  $path"
}

echo
echo "Claude Code"
link "$ROOT/skills" "$HOME/.claude/skills"
# Output styles change the default response style. Selecting one is a settings
# change (outputStyle), not a symlink: see the note at the end of this script.
link "$ROOT/output-styles" "$HOME/.claude/output-styles"
# Claude Code reads CLAUDE.md; the @import makes it defer to the shared AGENTS.md
# instead of duplicating it. Works whether or not it also reads AGENTS.md natively.
write "$HOME/.claude/CLAUDE.md" "@$ROOT/AGENTS.md"

echo
echo "Codex CLI"
link "$ROOT/skills"     "$HOME/.codex/skills"
link "$ROOT/AGENTS.md"  "$HOME/.codex/AGENTS.md"

# --- MCP servers -------------------------------------------------------------
# mcp/servers.json is the canonical record of which servers you run.
# It is deliberately NOT written into agent config automatically: Claude Code keeps
# user-scope MCP config inside ~/.claude.json alongside unrelated state, and Codex
# uses TOML. Clobbering either would lose data. Add servers with the agent's own CLI
# (`claude mcp add ...`, `codex mcp add ...`) and keep servers.json as the list you
# replay on a new machine.
echo
echo "MCP"
say "canonical list: $ROOT/mcp/servers.json (not auto-installed — see comment in bin/sync)"

echo
if [ "$failed" -ne 0 ]; then
  echo "Finished with warnings above."
  exit 1
fi
if [ "$DRY_RUN" = "1" ]; then
  echo "Dry run only. Re-run without DRY_RUN to apply."
else
  echo "Done. Skills and docs are live immediately from now on — no need to re-run."
fi
